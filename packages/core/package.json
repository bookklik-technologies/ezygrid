{
  "name": "@ezygrid/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser/ezygrid.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-browser.mjs"
  },
  "dependencies": {
    "@ezygrid/model": "workspace:*",
    "@ezygrid/formula": "workspace:*",
    "@ezygrid/csv": "workspace:*"
  }
}
