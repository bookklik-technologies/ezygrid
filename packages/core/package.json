{
  "name": "@ezygrid/core",
  "version": "0.1.1",
  "description": "Workbook/worksheet facade, rendering, selection, editing, and history engine for Ezygrid.",
  "license": "MIT",
  "author": {
    "name": "Bookklik Technologies",
    "url": "https://github.com/bookklik-technologies"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookklik-technologies/ezygrid.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bookklik-technologies/ezygrid#readme",
  "bugs": {
    "url": "https://github.com/bookklik-technologies/ezygrid/issues"
  },
  "keywords": [
    "spreadsheet",
    "datagrid",
    "grid",
    "ezygrid"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./xlsx/*": {
      "types": "./dist/xlsx/*.d.ts",
      "import": "./dist/xlsx/*.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx/index.d.ts",
      "import": "./dist/xlsx/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser/ezygrid.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-browser.mjs"
  },
  "dependencies": {
    "@ezygrid/model": "workspace:*",
    "@ezygrid/formula": "workspace:*",
    "@ezygrid/csv": "workspace:*"
  }
}
