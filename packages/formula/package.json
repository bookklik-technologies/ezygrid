{
  "name": "@ezygrid/formula",
  "version": "0.1.1",
  "description": "Excel-compatible formula lexer/parser, dependency graph, and function library for Ezygrid.",
  "license": "MIT",
  "author": {
    "name": "Bookklik Technologies",
    "url": "https://github.com/bookklik-technologies"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookklik-technologies/ezygrid.git",
    "directory": "packages/formula"
  },
  "homepage": "https://github.com/bookklik-technologies/ezygrid#readme",
  "bugs": {
    "url": "https://github.com/bookklik-technologies/ezygrid/issues"
  },
  "keywords": [
    "spreadsheet",
    "formula",
    "parser",
    "excel",
    "ezygrid"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker-main": {
      "types": "./dist/worker-main.d.ts",
      "import": "./dist/worker-main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ezygrid/model": "workspace:*"
  }
