{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "inlineSources": true,
    "sourceMap": true,
    "paths": {
      "@ezygrid/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src"],
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "skipLibCheck": true
  }
}
