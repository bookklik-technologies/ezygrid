{
  "name": "ezygrid",
  "private": true,
  "version": "0.1.0",
  "description": "Framework-agnostic JavaScript/TypeScript spreadsheet and data-grid library.",
  "keywords": [
    "spreadsheet",
    "datagrid",
    "data-grid",
    "grid",
    "table",
    "excel",
    "formulas",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Bookklik Technologies",
    "url": "https://github.com/bookklik-technologies"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookklik-technologies/ezygrid.git"
  },
  "homepage": "https://github.com/bookklik-technologies/ezygrid#readme",
  "bugs": {
    "url": "https://github.com/bookklik-technologies/ezygrid/issues"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0",
    "vue": "^3.5.42"
  }
}
