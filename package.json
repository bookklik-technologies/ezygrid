{
  "name": "@bookklik/ezygrid",
  "version": "0.1.6",
  "description": "Framework-agnostic JavaScript/TypeScript spreadsheet and data-grid library.",
  "keywords": [
    "spreadsheet",
    "datagrid",
    "data-grid",
    "grid",
    "table",
    "excel",
    "formulas",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "a-hakim",
    "url": "https://github.com/bookklik-technologies"
  },
  "type": "module",
  "main": "./dist/ezygrid.cjs",
  "module": "./dist/ezygrid.esm.js",
  "unpkg": "./dist/ezygrid.umd.js",
  "jsdelivr": "./dist/ezygrid.umd.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ezygrid.esm.js",
      "require": "./dist/ezygrid.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser/ezygrid.js"
    },
    "./themes/default.css": "./dist/themes/default.css",
    "./themes/dark.css": "./dist/themes/dark.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookklik-technologies/ezygrid.git"
  },
  "homepage": "https://github.com/bookklik-technologies/ezygrid#readme",
  "bugs": {
    "url": "https://github.com/bookklik-technologies/ezygrid/issues"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build && node scripts/build-dist.mjs",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  }
}
